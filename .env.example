# Copy this file to .env and fill in real values there.
# .env is gitignored — never commit real keys or credentials.

# --- Database ---
# Path to the SQLite database file. Created automatically if it doesn't exist.
PORTFOLIO_DB_PATH=./data/portfolio.db

# --- TradeRepublic (pytr) --- [Phase: TradeRepublic connector]
# pytr logs in with your phone number + PIN and handles 2FA interactively
# the first time you run it. Only needed once that connector is wired up.
TRADEREPUBLIC_PHONE_NUMBER=
TRADEREPUBLIC_PIN=

# --- Crypto exchange APIs --- [Phase: crypto connector]
# Use READ-ONLY keys only. Disable trading/withdrawal permissions and
# IP-whitelist where the exchange supports it.
BINANCE_API_KEY=
BINANCE_API_SECRET=
COINBASE_API_KEY=
COINBASE_API_SECRET=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# --- CoinGecko (crypto price data) --- [Phase: crypto connector]
COINGECKO_API_KEY=

# --- Gold spot price API --- [Phase: gold] (provider not yet chosen)
GOLD_API_KEY=

# --- Claude API (ad-hoc research tool) --- [Phase: research tool]
ANTHROPIC_API_KEY=
