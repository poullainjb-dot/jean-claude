# Copy to .env.local (dev) and configure real values as real environment
# variables in Vercel's project settings for production — .env.local is
# gitignored and never committed either way.

# --- Database ---
# Postgres connection string. Use Neon (or Vercel Postgres, which is Neon
# under the hood) in production; a local Postgres works fine for dev.
DATABASE_URL=postgres://user:password@localhost:5432/portfolio_dev

# --- Auth ---
# Single shared password gating the whole app (this is a single-user tool,
# not a multi-account system) — see src/lib/auth.ts and src/proxy.ts.
# Required: the app fails closed (500, not silently open) if this is unset.
DASHBOARD_PASSWORD=

# --- Stock/ETF live prices ---
# Two providers, tried in order — see src/lib/priceRefresh.ts.
# 1. Twelve Data: official, documented, needs this key. Free tier: 800
#    requests/day, 8/minute. Reliable for US tickers; free tier paywalls
#    most non-US exchanges. Get a free key at https://twelvedata.com — no
#    card required.
# 2. Yahoo Finance: unofficial, no key needed (nothing to set here for it)
#    — the fallback for whatever Twelve Data's free tier can't reach.
TWELVEDATA_API_KEY=

# --- TradeRepublic (pytr) --- [later phase, if/when ported]
TRADEREPUBLIC_PHONE_NUMBER=
TRADEREPUBLIC_PIN=

# --- Crypto exchange APIs (read-only keys only!) --- [later phase]
BINANCE_API_KEY=
BINANCE_API_SECRET=
COINBASE_API_KEY=
COINBASE_API_SECRET=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# --- CoinGecko --- [later phase]
COINGECKO_API_KEY=

# --- Gold spot price API --- [later phase, provider TBD]
GOLD_API_KEY=

# --- Claude API (ad-hoc research tool) --- [later phase]
ANTHROPIC_API_KEY=
